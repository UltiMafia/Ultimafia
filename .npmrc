# onnxruntime-node's install script downloads the CUDA and TensorRT execution
# provider libraries from NuGet on linux/x64 -- a ~500 MB package, ~284 MB of
# .so files -- every time it is installed. That download has no timeout and no
# progress output, so npm sits there with no output and looks hung forever on a
# server where api.nuget.org is slow or blocked. The rule filter runs the int8
# model on CPU, and those CPU binaries ship inside the npm package, so the
# download buys nothing.
#
# npm passes this through to lifecycle scripts as
# npm_config_onnxruntime_node_install, which onnxruntime-node's install script
# reads before it decides to fetch anything.
onnxruntime-node-install=skip
