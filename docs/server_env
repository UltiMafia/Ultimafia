NODE_ENV=development_docker
PORT=3000
UPLOAD_PATH=uploads
BASE_URL=http://localhost:3001

GAME_PORTS=[3010]
CHAT_PORT=2999
SOCKET_PING_INTERVAL=10000
SERVER_SOCKET_PING_INTERVAL=2000
GAME_CREATION_TIMEOUT=5000

# any string to replace x
SESSION_SECRET=x
LOAD_BALANCER_KEY=x
BOT_KEY=x

# follow your mongo setup
MONGO_URL=mongodb
MONGO_DB=ultimafia
MONGO_USER=admin
MONGO_PW=password

# any number from 0 to 15
REDIS_DB=0

# get your firebase API key
FIREBASE_API_KEY=x
FIREBASE_AUTH_DOMAIN=x.firebaseapp.com
FIREBASE_PROJECT_ID=x
FIREBASE_MESSAGING_SENDER_ID=x
FIREBASE_APP_ID=x
FIREBASE_MEASUREMENT_ID=x
FIREBASE_JSON_FILE=firebase.json

EMAIL_DOMAINS=["gmail.com", "hotmail.com", "aol.com", "msn.com", "yandex.ru", "live.com", "icloud.com", "gmail.com.sg", "yahoo.com", "mail.com", "outlook.com", "hotmail.co.uk"]

# optional
IP_API_URL=https://ipqualityscore.com/api/json/ip
IP_API_KEY=x
IP_API_PARAMS=strictness=0&allow_public_access_points=true&fast=true&lighter_penalties=true&mobile=true

# optional
RECAPTCHA_KEY=x

RESERVED_NAMES={}

#optional
REPORT_DISCORD_WEBHOOK=[{"boards": ["boardShortId"], "hook": "discordWebhookUrl"}]

# optional - GitHub PAT used to file user-submitted feedback as issues
# Token needs "issues: write" permission on the repo below
GITHUB_ACCESS_TOKEN=
GITHUB_FEEDBACK_OWNER=ultimafia
GITHUB_FEEDBACK_REPO=ultimafia

#optional - dev use only
DEV_USERNAME=x

# optional - web push notifications ("your game is starting" while the tab is
# closed or backgrounded). Push is disabled and the client skips the whole flow
# when these are unset, so a dev environment works fine without them.
# Generate a pair with:  node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_SUBJECT must be a mailto: or https: URL identifying the sender; it
# defaults to BASE_URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# optional - Sign in with Apple server-to-server notifications
# (POST /api/auth/apple/notifications). Comma-separated list of allowed "aud"
# values: the iOS bundle ID and/or web Services ID. Unset = all rejected (400).
APPLE_SIWA_AUDIENCE=VCCCLLC.Ultimafia

# optional - dev/QA testing only. Comma-separated user ids, e.g.
# BAN_APPEAL_VOTER_ALLOWLIST=laJoqacXr,AbC123xyz
# When set, a site-ban appeal goes only to the listed users who are also in the
# Owner or Admin group: only they count toward the admin total N, get the appeal
# DM and inbox notification, and can view or vote on it. Accepting still needs
# min(2, N) accept votes. If none of the listed users is an Owner or Admin,
# N = 0 and appeals stay pending. Unset or empty = every Owner and Admin, as in
# production. Read at startup. Leave it unset in production.
BAN_APPEAL_VOTER_ALLOWLIST=

# optional - dev/QA testing only ("Plot Armor"). Comma-separated user ids, e.g.
# PLOT_ARMOR_USER_IDS=laJoqacXr,Or7_sztgH
# Parsed like BAN_APPEAL_VOTER_ALLOWLIST (trimmed, blanks skipped, exact match).
# Listed accounts are never banned just because they are linked (shared IP or
# device fingerprint) to a banned account, or automatically: the mod Ban "All
# linked accounts" cascade, the report-ruling cascade and the ban for signing
# in to a banned account's email while signed in all skip them, and a linked
# Unban leaves their own bans alone. The mod log notes each skip ("Plot Armor:
# skipped N linked accounts"). A ban that names a listed account directly still
# applies. A new sign-up whose IP or device (platform + stable fingerprint) is
# also used by a listed account skips the sign-up ban-evasion checks (banned-
# user IP, exact banned fingerprint, partial-match flag), with a warning each
# time; a sign-up matching a banned user but no listed account is still
# blocked or flagged. Unset or empty = off, as in production. Read at startup; the server
# logs a warning when it is set. Leave it unset in production.
PLOT_ARMOR_USER_IDS=
